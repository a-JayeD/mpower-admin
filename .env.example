# ------------------------------------------------------------------
# M.Power Engineering Admin – environment variables
# Copy this file to `.env.local` for local development.
# In Cloudflare Pages, add the same variables under
#   Settings → Environment variables (Production AND Preview).
#
# Only PUBLIC values belong here. Both values below are safe to expose
# in the browser: data protection is enforced by Row Level Security.
# NEVER put the Supabase service_role key in any VITE_ variable.
# ------------------------------------------------------------------

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → Project API keys → anon / public
# (newer projects may call this the "publishable" key)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: shown in the browser tab and login screen
VITE_APP_NAME=M.Power Engineering Admin
