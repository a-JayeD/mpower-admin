# ------------------------------------------------------------------
# For the LOCAL maintenance scripts only (npm run restore / backup:storage).
# Copy to `.env.restore`, fill in, run the script, then DELETE the file.
#
# The service_role key bypasses all security rules. Never commit it,
# never put it in Cloudflare, never put it in a VITE_ variable.
# ------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here
